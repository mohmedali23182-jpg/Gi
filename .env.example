# دواء وحياة — Dawa & Hayah (Stage 01 Environment Example)
# تحذير أمني: لا تضع أي مفاتيح سرية داخل تطبيق Android أو داخل Git.
# المتغيرات التالية مخصصة حصرياً لبيئة نشر دوال Neon السحابية (Neon Compute Functions) خارج تطبيق Android.

# Base URL for published Neon Compute Functions API (Public HTTPS endpoint, optional in Stage 01)
NEON_PUBLIC_API_BASE_URL=""

# Server-side only secrets for Neon Functions deployment (NEVER embed in Android APK or BuildConfig)
# DATABASE_URL="postgresql://role:password@ep-example.region.aws.neon.tech/dawa_hayah?sslmode=require"
# AWS_ENDPOINT_URL_S3="https://s3.region.neon.storage"
# AWS_ACCESS_KEY_ID="NEON_STORAGE_ACCESS_KEY_SERVER_ONLY"
# AWS_SECRET_ACCESS_KEY="NEON_STORAGE_SECRET_KEY_SERVER_ONLY"
# NEON_STORAGE_BUCKET_PUBLIC="dawa-hayah-public-packs"
